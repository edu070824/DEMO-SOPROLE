<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <VBox class="soproleSidebar">
    <Text text="BROWSE" class="soproleSideKicker" />
    <VBox class="soproleSideNav">
      <HBox alignItems="Center" class="{= ${view>/page} !== 'catalog' ? 'soproleNavItem soproleNavActive' : 'soproleNavItem' }">
        <core:Icon src="sap-icon://favorite" class="soproleNavIcon" />
        <Link text="Suggested order" press=".onNavHome" class="soproleNavLink" />
      </HBox>
      <HBox alignItems="Center" class="{= ${view>/page} === 'catalog' ? 'soproleNavItem soproleNavActive' : 'soproleNavItem' }">
        <core:Icon src="sap-icon://grid" class="soproleNavIcon" />
        <Link text="All products" press=".onNavCatalog" class="soproleNavLink" />
      </HBox>
    </VBox>
    <List items="{/categories}" showSeparators="None" class="soproleCatList">
      <StandardListItem title="{Name}" counter="{Count}" type="Active" press=".onCategoryPress" />
    </List>
  </VBox>
</core:FragmentDefinition>
