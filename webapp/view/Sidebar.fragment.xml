<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <VBox class="soproleSidebar">

    <Text
        text="CATEGORIES"
        class="soproleSidebarTitle"/>

    <VBox class="soproleSuggestedBox">

        <HBox
            alignItems="Center"
            class="soproleSuggestedItem">

            <core:Icon
                src="sap-icon://favorite"
                class="soproleSuggestedIcon"/>

            <Link
                text="Suggested order"
                press=".onNavHome"
                class="soproleSuggestedLink"/>

        </HBox>

    </VBox>

    <List
    items="{/categories}"
    showSeparators="None"
    mode="SingleSelectMaster"
    includeItemInSelection="true"
    selectionChange=".onCategoryPress"
    class="soproleCatList">

    <StandardListItem
        title="{Name}"
        counter="{Count}"
        type="Active"/>

</List>

</VBox>
</core:FragmentDefinition>
