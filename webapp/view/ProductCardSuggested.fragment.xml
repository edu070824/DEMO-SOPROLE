<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <VBox class="soproleSuggestedCard">
    <VBox class="soproleSuggestedImgWrap">
      <Label text="Habitual" class="soproleSuggestedTag soproleSuggestedTagRed" visible="{= ${Tag} === 'Habitual' }" />
      <Label text="Pruébalo" class="soproleSuggestedTag soproleSuggestedTagGold" visible="{= ${Tag} === 'Pruébalo' }" />
      <Label text="Nuevo" class="soproleSuggestedTag soproleSuggestedTagBlue" visible="{= ${Tag} === 'Nuevo' }" />
      <Image src="{ImageUrl}" class="soproleSuggestedImg" densityAware="false" />
    </VBox>

    <Text text="{Name}" maxLines="2" class="soproleSuggestedName" />
    <Text text="{path: 'Suggested', formatter: '.formatter.suggestedEA'}" visible="{= ${Suggested} > 0 }" class="soproleSuggestedQty" />

    <HBox justifyContent="SpaceBetween" alignItems="Center" class="soproleSuggestedFoot">
      <Text text="{path: 'Price', formatter: '.formatter.price'}" class="soproleSuggestedPrice" />
      <Button icon="sap-icon://add" type="Emphasized" class="soproleSuggestedAdd" press=".onAdd" />
    </HBox>
  </VBox>
</core:FragmentDefinition>