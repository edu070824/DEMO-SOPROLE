<mvc:View
  controllerName="soprole.portal.controller.Home"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:f="sap.f"
  displayBlock="true">

  <Page id="home" showHeader="false" backgroundDesign="Solid" class="soprolePage">
    <content>

      <HBox class="soproleNotice" justifyContent="Center" alignItems="Center">
        <core:Icon src="sap-icon://message-information" class="soproleNoticeIcon" />
        <Text text="Winter logistics: order cut-off moves to 14:00 from Mon 9 Jun." class="soproleNoticeText" />
        <Link text="Browse winter lines" class="soproleNoticeLink" press=".onNavCatalog" />
      </HBox>

      <core:Fragment fragmentName="soprole.portal.view.Header" type="XML" />

      <HBox class="soproleBody" alignItems="Start" wrap="Wrap">
        <core:Fragment fragmentName="soprole.portal.view.Sidebar" type="XML" />

        <VBox class="soproleMain">
          <layoutData><FlexItemData growFactor="1" baseSize="0%" /></layoutData>

          <VBox class="soproleHeading">
            <HBox alignItems="Center" class="soproleKickRow">
              <Text text="WHOLESALE PORTAL" class="soproleEyebrow" />
              <HBox alignItems="Center" class="soproleBlueprint"><core:Icon src="sap-icon://hint" class="soproleBpIcon" /><Text text="Blueprint" /></HBox>
            </HBox>
            <Title text="Welcome back, Allpress" level="H1" class="soproleH1" />
            <Text text="Here's your store at a glance — reorder, suggested items and what's on this week." class="soproleLead" />
          </VBox>

          <VBox class="soproleCard soproleLoyalty" binding="{/loyalty}">
            <HBox alignItems="Center" wrap="Wrap" class="soproleLoyaltyTop">
              <core:Icon src="sap-icon://wallet" class="soproleLoyaltyIcon" />
              <VBox class="soproleLoyaltyPts">
                <Text text="LOYALTY" class="soproleSideKicker" />
                <HBox alignItems="Baseline">
                  <Text text="{Points}" class="soproleLoyaltyNum" />
                  <Text text="points" class="soproleLoyaltyUnit" />
                </HBox>
              </VBox>
              <ObjectStatus text="{Tier}" state="Warning" class="soproleTierChip" />
              <VBox class="soproleLoyaltyBarWrap">
                <HBox justifyContent="SpaceBetween">
                  <Text text="{ToGoText}" class="soproleMuted" />
                  <Text text="{ToGoPoints} pts to go" class="soproleMutedStrong" />
                </HBox>
                <ProgressIndicator percentValue="{Progress}" showValue="false" state="None" class="soproleGoldBar" height="0.6rem" />
              </VBox>
              <HBox alignItems="Center" class="soproleBlueprint"><core:Icon src="sap-icon://hint" class="soproleBpIcon" /><Text text="Blueprint" /></HBox>
              <Button text="My Loyalty" icon="sap-icon://navigation-right-arrow" iconFirst="false" type="Transparent" press=".onOpenLoyalty" />
            </HBox>
            <HBox class="soproleLoyaltyExpire" alignItems="Center">
              <Text text="{ExpiringPoints} points" class="soproleMutedStrong" />
              <Text text="expire in {ExpiringDays} days — use them on your next order." class="soproleMuted" />
            </HBox>
            <HBox class="soproleChallenge" alignItems="Center" wrap="Wrap">
              <core:Icon src="sap-icon://competitor" class="soproleChallengeIcon" />
              <Text text="Challenge ·" class="soproleMuted" />
              <Text text="{ChallengeName}" class="soproleMutedStrong" />
              <ProgressIndicator percentValue="{ChallengePct}" showValue="true" displayValue="{ChallengePct}%" state="None" class="soproleVioletBar" width="14rem" height="0.6rem" />
            </HBox>
          </VBox>

          <VBox class="soproleCampaign">
            <Title text="Festival de Yoghurt &amp; Quesos" level="H2" class="soproleCampaignTitle" />
            <Text text="Las categorías estrella del invierno en un solo lugar — pensado para tu vitrina." class="soproleCampaignText" />
            <Button text="Ver la campaña" icon="sap-icon://navigation-right-arrow" iconFirst="false" class="soproleCampaignBtn" press=".onNavCatalog" />
          </VBox>

          <VBox class="soproleCard soproleSection">
            <HBox justifyContent="SpaceBetween" alignItems="End" class="soproleSectionHead" wrap="Wrap">
              <VBox>
                <HBox alignItems="Center" class="soproleKickRow"><core:Icon src="sap-icon://lightbulb" class="soproleKickIcon" /><Text text="SUGGESTED ORDER" class="soproleKicker" /></HBox>
                <HBox alignItems="Center"><Title text="Your essentials this week" level="H3" class="soproleSectionTitle" /><HBox alignItems="Center" class="soproleBlueprint"><core:Icon src="sap-icon://hint" class="soproleBpIcon" /><Text text="Blueprint" /></HBox></HBox>
              </VBox>
              <Link text="Review all →" press=".onNavCatalog" />
            </HBox>
            <f:GridContainer id="gridSuggested" class="soproleProductGrid" items="{/suggested}">
              <f:layout><f:GridContainerSettings rowSize="16rem" columnSize="9.5rem" gap="0.75rem" /></f:layout>
              <core:Fragment fragmentName="soprole.portal.view.ProductCardSuggested" type="XML" />
            </f:GridContainer>
          </VBox>

          <HBox class="soproleTwoCol" wrap="Wrap" alignItems="Start">
            <VBox class="soproleCard soproleSection soproleCol">
              <layoutData><FlexItemData growFactor="1" baseSize="0%" /></layoutData>
              <HBox justifyContent="SpaceBetween" alignItems="End" class="soproleSectionHead" wrap="Wrap">
                <VBox>
                  <HBox alignItems="Center" class="soproleKickRow"><core:Icon src="sap-icon://refresh" class="soproleKickIcon" /><Text text="REORDER" class="soproleKicker" /></HBox>
                  <Title text="Recent orders" level="H3" class="soproleSectionTitle" />
                </VBox>
                <HBox alignItems="Center" class="soproleHeadActions">
                  <HBox alignItems="Center" class="soproleBlueprint"><core:Icon src="sap-icon://hint" class="soproleBpIcon" /><Text text="Blueprint" /></HBox>
                  <Link text="View all →" press=".onNavCatalog" />
                </HBox>
              </HBox>
              <List items="{/orders}" showSeparators="Inner" class="soproleOrderList">
                <CustomListItem>
                  <HBox justifyContent="SpaceBetween" alignItems="Center" class="soproleOrderRow">
                    <VBox>
                      <Text text="{OrderId}" class="soproleOrderId" />
                      <Text text="{ parts: ['Status','Lines','Total'], formatter: '.formatter.orderLine' }" class="soproleMuted" />
                    </VBox>
                    <Button text="Reorder" icon="sap-icon://refresh" type="Default" press=".onReorder" />
                  </HBox>
                </CustomListItem>
              </List>
            </VBox>

            <VBox class="soproleCard soproleSection soproleCol">
              <layoutData><FlexItemData growFactor="1" baseSize="0%" /></layoutData>
              <HBox justifyContent="SpaceBetween" alignItems="End" class="soproleSectionHead" wrap="Wrap">
                <VBox>
                  <HBox alignItems="Center" class="soproleKickRow"><core:Icon src="sap-icon://lightbulb" class="soproleKickIcon" /><Text text="CAMPAIGNS" class="soproleKicker" /></HBox>
                  <Title text="What's on this week" level="H3" class="soproleSectionTitle" />
                </VBox>
                <HBox alignItems="Center" class="soproleBlueprint"><core:Icon src="sap-icon://hint" class="soproleBpIcon" /><Text text="Blueprint" /></HBox>
              </HBox>
              <List items="{/campaigns}" showSeparators="None" class="soproleCampaignList">
                <StandardListItem title="{Title}" type="Navigation" press=".onNavCatalog" />
              </List>
            </VBox>
          </HBox>

          <VBox class="soproleCard soproleSection">
            <HBox justifyContent="SpaceBetween" alignItems="End" class="soproleSectionHead" wrap="Wrap">
              <VBox>
                <HBox alignItems="Center" class="soproleKickRow"><core:Icon src="sap-icon://lightbulb" class="soproleKickIcon" /><Text text="FEATURED" class="soproleKicker" /></HBox>
                <Title text="Featured products" level="H3" class="soproleSectionTitle" />
              </VBox>
              <Link text="View all →" press=".onNavCatalog" />
            </HBox>
            <f:GridContainer id="gridFeatured" class="soproleProductGrid" items="{/featured}">
              <f:layout><f:GridContainerSettings rowSize="14rem" columnSize="9.5rem" gap="0.75rem" /></f:layout>
              <core:Fragment fragmentName="soprole.portal.view.ProductCardFull" type="XML" />
            </f:GridContainer>
          </VBox>

          <VBox class="soproleCard soproleSection">
            <HBox justifyContent="SpaceBetween" alignItems="End" class="soproleSectionHead" wrap="Wrap">
              <VBox>
                <HBox alignItems="Center" class="soproleKickRow"><core:Icon src="sap-icon://lightbulb" class="soproleKickIcon" /><Text text="PERSONALIZED FOR YOU" class="soproleKicker" /></HBox>
                <HBox alignItems="Center"><Title text="Picked for your bakery" level="H3" class="soproleSectionTitle" /><HBox alignItems="Center" class="soproleBlueprint"><core:Icon src="sap-icon://hint" class="soproleBpIcon" /><Text text="Bakery cluster" /></HBox></HBox>
              </VBox>
              <Link text="View all →" press=".onNavCatalog" />
            </HBox>
            <HBox class="soproleBakeryBanner" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
              <Text text="For your bakery — Soprole cream, butter &amp; dulce de leche for this week's bake" class="soproleBakeryText" />
              <Link text="Shop now →" class="soproleBakeryLink" press=".onNavCatalog" />
            </HBox>
            <f:GridContainer id="gridBakery" class="soproleProductGrid" items="{/bakery}">
              <f:layout><f:GridContainerSettings rowSize="14rem" columnSize="9.5rem" gap="0.75rem" /></f:layout>
              <core:Fragment fragmentName="soprole.portal.view.ProductCardFull" type="XML" />
            </f:GridContainer>
          </VBox>

          <HBox class="soproleFooter" justifyContent="SpaceBetween" wrap="Wrap">
            <Text text="© 2026 Soprole S.A. · Wholesale Portal B2B" class="soproleMuted" />
            <Text text="Omnichannel prototype · net prices + VAT 19%" class="soproleMuted" />
          </HBox>

        </VBox>
      </HBox>

    </content>
  </Page>
</mvc:View>