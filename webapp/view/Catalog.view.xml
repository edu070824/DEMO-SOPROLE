<mvc:View
  controllerName="soprole.portal.controller.Catalog"
  xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:f="sap.f"
  displayBlock="true">

  <Page id="catalog" showHeader="false" backgroundDesign="Solid" class="soprolePage">
    <content>

      <HBox class="soproleNotice" justifyContent="Center" alignItems="Center">
        <core:Icon src="sap-icon://message-information" class="soproleNoticeIcon" />
        <Text text="Winter logistics: order cut-off moves to 14:00 from Mon 9 Jun." class="soproleNoticeText" />
        <Link text="Browse winter lines" class="soproleNoticeLink" />
      </HBox>

      <core:Fragment fragmentName="soprole.portal.view.Header" type="XML" />

      <VBox class="soproleBody soproleCatalogBody">
        <HBox alignItems="Center" class="soproleBreadcrumb">
          <Link text="Home" press=".onNavHome" />
          <Text text="/" class="soproleMuted" />
          <Text text="All products" class="soproleMutedStrong" />
        </HBox>

        <HBox alignItems="Start" wrap="Wrap">
          <core:Fragment fragmentName="soprole.portal.view.Sidebar" type="XML" />

          <VBox class="soproleMain">
            <layoutData><FlexItemData growFactor="1" baseSize="0%" /></layoutData>

            <HBox justifyContent="SpaceBetween" alignItems="End" class="soproleSectionHead" wrap="Wrap">
              <VBox>
                <HBox alignItems="Center">
                  <Title text="Catalogue" level="H1" class="soproleH1" />
                  <HBox alignItems="Center" class="soproleBlueprint"><core:Icon src="sap-icon://hint" class="soproleBpIcon" /><Text text="Blueprint" /></HBox>
                </HBox>
                <Text text="1.823 productos" class="soproleMuted" />
              </VBox>
              <HBox alignItems="Center" class="soproleSortBox">
                <SegmentedButton selectedKey="{view>/catView}">
                  <items>
                    <SegmentedButtonItem key="grid" icon="sap-icon://grid" />
                    <SegmentedButtonItem key="list" icon="sap-icon://list" />
                  </items>
                </SegmentedButton>
                <Select selectedKey="{view>/sort}" change=".onSortChange">
                  <core:Item key="nameAsc" text="Name A-Z" />
                  <core:Item key="nameDesc" text="Name Z-A" />
                  <core:Item key="priceAsc" text="Price ↑" />
                  <core:Item key="priceDesc" text="Price ↓" />
                </Select>
              </HBox>
            </HBox>

            <f:GridContainer id="catalogGrid" class="soproleProductGrid" items="{/catalog}" visible="{= ${view>/catView} !== 'list' }">
              <f:layout><f:GridContainerSettings
  rowSize="16rem"
  columnSize="13rem"
  gap="1rem" /></f:layout>
              <core:Fragment fragmentName="soprole.portal.view.ProductCardFull" type="XML" />
            </f:GridContainer>

            <List id="catalogList" items="{/catalog}" showSeparators="Inner" visible="{= ${view>/catView} === 'list' }" class="soproleCatalogList">
              <CustomListItem>
                <HBox alignItems="Center" class="soproleListRow">
                  <Image src="{ImageUrl}" class="soproleListImg" densityAware="false" />
                  <VBox class="soproleListInfo">
                    <Text text="{Brand}" class="soproleProductBrand" />
                    <Text text="{Name}" maxLines="1" class="soproleProductName" />
                  </VBox>
                  <Text text="{path: 'Price', formatter: '.formatter.price'}" class="soprolePrice" />
                  <HBox alignItems="Center" class="soproleQtyStepper">
                    <Button icon="sap-icon://less" press=".onQtyMinus" class="soproleStepBtn" />
                    <Text text="{Qty}" class="soproleQtyVal" />
                    <Button icon="sap-icon://add" press=".onQtyPlus" class="soproleStepBtn" />
                  </HBox>
                  <Button text="Add" icon="sap-icon://add" press=".onAddProduct" class="soproleAddDark" />
                </HBox>
              </CustomListItem>
            </List>

            <HBox class="soproleFooter" justifyContent="SpaceBetween" wrap="Wrap">
              <Text text="© 2026 Soprole S.A. · Wholesale Portal B2B" class="soproleMuted" />
              <Text text="Omnichannel prototype · net prices + VAT 19%" class="soproleMuted" />
            </HBox>
          </VBox>
        </HBox>
      </VBox>

    </content>
  </Page>
</mvc:View>
